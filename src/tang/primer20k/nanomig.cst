// Tang Primer 20K Dock - PIN CONSTRAINTS SKELETON (NOT FINAL)
// All locations below must be filled in from the Sipeed Primer 20K Dock schematic.
// Ports are the same as primer25k/top.sv. The 27 MHz clock pin is believed to be H11 - verify!

IO_LOC "clk" H11;  // 27MHz, VERIFY
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

