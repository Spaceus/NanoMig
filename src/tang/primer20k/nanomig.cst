// Tang Primer 20K Dock (3713/3714) + SOM 3961 - NanoMig pin constraints
// Sources: Sipeed "Tang_Primer_20K_Dock_3714_Schematics.pdf" and
//          "Tang_Primer_20K_SOM-3961_Schematic.pdf".
// Pins marked TODO are not final (see README.md).

// 27 MHz oscillator on the SOM
IO_LOC "clk" H11;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Dock keys, active low. Key_1/Key_2 are in the 1.5V bank 4
IO_LOC "user_n" T3;      // Key_1
IO_PORT "user_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
IO_LOC "reset_n" T2;     // Key_2
IO_PORT "reset_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;

// Dock LEDs, active low (needs use_done_as_gpio/use_ready_as_gpio)
IO_LOC "leds_n[0]" C13;  // Orange_LED0 (DONE pin)
IO_PORT "leds_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "leds_n[1]" A13;  // Orange_LED1 (READY pin)
IO_PORT "leds_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// SPI NOR flash on the SOM (only IO0/IO1 reach the FPGA)
IO_LOC "mspi_cs" M9;
IO_PORT "mspi_cs" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "mspi_clk" L10;
IO_PORT "mspi_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "mspi_di" R10;    // flash SI
IO_PORT "mspi_di" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "mspi_do" P10;    // flash SO
IO_PORT "mspi_do" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// microSD slot on the SOM (SDIO wiring, SPI mode like the other boards)
IO_LOC "sd_clk" N10;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_cmd" R14;     // MOSI
IO_PORT "sd_cmd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_dat[0]" M8;   // MISO
IO_PORT "sd_dat[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_dat[1]" M7;
IO_PORT "sd_dat[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_dat[2]" M10;
IO_PORT "sd_dat[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_dat[3]" N11;  // CS
IO_PORT "sd_dat[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// HDMI connector (banks 0/1; 3714 "DVI optimize" does not change the pins)
IO_LOC "tmds_clk_p" G16,H15;   // HDMI_TXC
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[0]" H14,H16;  // HDMI_TX0
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[1]" J15,K16;  // HDMI_TX1
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[2]" K14,K15;  // HDMI_TX2
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;

// ---------------------------------------------------------------------
// TODO: FPGA Companion (MCU) on a PMOD. J14 (MIC, 2x6) and J12 (DVP, 2x6)
// are free 3.3V candidates, e.g. J14: MIC_DAT0 P8? ... see README.md
// pmod_companion_din / dout / clk / ss / intn
// TODO: external SDRAM module - the dock has no 2x20 header, see README.md
// O_sdram_* / IO_sdram_dq: not assigned. Without these pins the design can
// not be placed. The SOM DDR3 controller replaces them in the long run.

// ---------------------------------------------------------------------
// DDR3 SDRAM on the SOM 3961 (H5TQ1G63EFR, 64M x16 = 128 MB), from the SOM schematic.
// Port names follow the Gowin "DDR3 Memory Interface" IP. IO_TYPE/impedance values are
// first guesses: replace with what the IP generator / Sipeed DDR3 example proposes.
IO_LOC "O_ddr_addr[0]" F7;
IO_PORT "O_ddr_addr[0]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[1]" A4;
IO_PORT "O_ddr_addr[1]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[2]" D6;
IO_PORT "O_ddr_addr[2]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[3]" F8;
IO_PORT "O_ddr_addr[3]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[4]" C4;
IO_PORT "O_ddr_addr[4]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[5]" E6;
IO_PORT "O_ddr_addr[5]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[6]" B1;
IO_PORT "O_ddr_addr[6]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[7]" D8;
IO_PORT "O_ddr_addr[7]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[8]" A5;
IO_PORT "O_ddr_addr[8]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[9]" F9;
IO_PORT "O_ddr_addr[9]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[10]" K3;
IO_PORT "O_ddr_addr[10]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[11]" B7;
IO_PORT "O_ddr_addr[11]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[12]" A3;
IO_PORT "O_ddr_addr[12]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_addr[13]" C8;
IO_PORT "O_ddr_addr[13]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_ba[0]" H4;
IO_PORT "O_ddr_ba[0]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_ba[1]" D3;
IO_PORT "O_ddr_ba[1]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_ba[2]" H5;
IO_PORT "O_ddr_ba[2]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "IO_ddr_dq[0]" G5;
IO_PORT "IO_ddr_dq[0]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[1]" F5;
IO_PORT "IO_ddr_dq[1]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[2]" F4;
IO_PORT "IO_ddr_dq[2]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[3]" F3;
IO_PORT "IO_ddr_dq[3]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[4]" E2;
IO_PORT "IO_ddr_dq[4]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[5]" C1;
IO_PORT "IO_ddr_dq[5]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[6]" E1;
IO_PORT "IO_ddr_dq[6]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[7]" B3;
IO_PORT "IO_ddr_dq[7]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[8]" M3;
IO_PORT "IO_ddr_dq[8]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[9]" K4;
IO_PORT "IO_ddr_dq[9]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[10]" N2;
IO_PORT "IO_ddr_dq[10]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[11]" L1;
IO_PORT "IO_ddr_dq[11]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[12]" P4;
IO_PORT "IO_ddr_dq[12]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[13]" H3;
IO_PORT "IO_ddr_dq[13]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[14]" R1;
IO_PORT "IO_ddr_dq[14]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "IO_ddr_dq[15]" M2;
IO_PORT "IO_ddr_dq[15]" IO_TYPE=SSTL15 PULL_MODE=UP;
IO_LOC "O_ddr_cke" J2;
IO_PORT "O_ddr_cke" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_odt" R3;
IO_PORT "O_ddr_odt" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_cs_n" P5;
IO_PORT "O_ddr_cs_n" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_ras_n" R4;
IO_PORT "O_ddr_ras_n" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_cas_n" R6;
IO_PORT "O_ddr_cas_n" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_we_n" L2;
IO_PORT "O_ddr_we_n" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_reset_n" B9;
IO_PORT "O_ddr_reset_n" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_dqm[0]" G1;
IO_PORT "O_ddr_dqm[0]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_dqm[1]" K5;
IO_PORT "O_ddr_dqm[1]" IO_TYPE=SSTL15 PULL_MODE=NONE;
IO_LOC "O_ddr_clk" J1,J3;
IO_PORT "O_ddr_clk" IO_TYPE=SSTL15D PULL_MODE=NONE;
IO_LOC "IO_ddr_dqs[0]" G2,G3;
IO_PORT "IO_ddr_dqs[0]" IO_TYPE=SSTL15D PULL_MODE=UP;
IO_LOC "IO_ddr_dqs[1]" J5,K6;
IO_PORT "IO_ddr_dqs[1]" IO_TYPE=SSTL15D PULL_MODE=UP;
